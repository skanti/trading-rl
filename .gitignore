
# hidden files
.*

# generated files
MUJOCO_LOG.TXT
__pycache__/
*.egg-info/
.DS_Store
outputs
# The refreshed trading universe lives in /data/ppv1/live/master.txt.
# Ignore the former location if an older command recreates it.
/data/master.txt
/ml/artifacts/
/ml/evaluation_*.json
/ml/evaluation_*.csv

# except gitignore file
!.gitignore
!.gitattributes

# dashboard build output
/dashboard/firebase-debug.log
/dashboard/firebase-debug.*.log
/dashboard/node_modules/
/dashboard/.output/
/dashboard/.nuxt/
/dashboard/.data/
/dashboard/.secrets/
/dashboard/dist

# Committed on purpose despite the blanket ".*" rule above: config.yaml is the
# single source of truth, and deploy.sh hard-requires .firebaserc.
!/dashboard/config.yaml
!/dashboard/.firebaserc
